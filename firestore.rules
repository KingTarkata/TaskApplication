rules_version = '2';

// Data layout:
//   users/{uid}                          -> { householdId }            (each person's pointer to their household)
//   households/{hid}                     -> { name, ownerId, createdAt }
//   households/{hid}/members/{uid}       -> { displayName, color, joinedAt, inviteCode? }
//   households/{hid}/tasks/{taskId}      -> chores
//   households/{hid}/categories/{catId}  -> plots
//   invites/{code}                       -> { householdId, createdBy, createdAt }  (6-char join codes)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    function householdOwner(hid) {
      return getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerId;
    }

    // Each person can only see and change their own pointer
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMember(hid);
      // Members can rename; ownership can't be handed to someone else by a non-owner
      allow update: if isMember(hid) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember(hid);
        // You can add yourself: as the household's owner, or by presenting a valid invite code for it
        allow create: if signedIn() && request.auth.uid == uid && (
          householdOwner(hid) == request.auth.uid ||
          (request.resource.data.inviteCode is string &&
           get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == hid)
        );
        // You can edit your own profile; you (or the owner) can remove you
        allow update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || householdOwner(hid) == request.auth.uid);
      }

      match /tasks/{taskId} {
        allow read, write: if isMember(hid);
      }

      match /categories/{catId} {
        allow read, write: if isMember(hid);
      }
    }

    // Invite codes: anyone signed in can look up a code they know, but codes can't be listed
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.householdId);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
